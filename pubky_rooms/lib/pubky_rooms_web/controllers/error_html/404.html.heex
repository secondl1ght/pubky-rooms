<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#05050A" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={~p"/images/pubky-favicon.svg"} type="image/svg+xml" />
    <title>Page not found · Pubky Rooms</title>
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>
  <body class="min-h-dvh bg-background text-foreground">
    <main class="mx-auto flex min-h-dvh w-full max-w-(--container-max-width) flex-col items-center justify-center gap-6 px-6 py-16 text-center">
      <a href="/" class="inline-flex items-end gap-1.5 select-none">
        <img
          src={~p"/images/pubky-logo.svg"}
          alt="Pubky"
          width="109"
          height="36"
          class="h-9 w-auto"
        />
        <span class="text-brand text-[1.625rem] leading-[2.0625rem] font-bold tracking-tight">Rooms</span>
      </a>
      <div class="flex flex-col items-center gap-2">
        <h1 class="text-2xl font-bold">Page not found</h1>
        <p class="max-w-md text-sm text-muted-foreground">
          There is nothing at this address. Room links look like /r/&lt;owner&gt;/&lt;id&gt;; the lobby lists every room this server knows.
        </p>
      </div>
      <a href="/" class={PubkyRoomsWeb.UI.Button.button_classes("default", "default")}>Back to the lobby</a>
    </main>
  </body>
</html>
