<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#05050A" />
    <meta name="color-scheme" content="dark" />
    <meta name="application-name" content="Pubky Rooms" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Rooms" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" href={~p"/images/pubky-favicon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/images/icons/apple-touch-icon.png"} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <%!-- the data attributes keep LiveView's client-side title updates working;
         an empty page title is the site name alone (live_title would add the suffix) --%>
    <title data-default="Pubky Rooms" data-suffix=" · Pubky Rooms" phx-no-format>{PubkyRoomsWeb.Meta.document_title(assigns)}</title>
    <meta name="description" content={PubkyRoomsWeb.Meta.description(assigns)} />
    <meta property="og:site_name" content={PubkyRoomsWeb.Meta.site()} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={PubkyRoomsWeb.Meta.title(assigns)} />
    <meta property="og:description" content={PubkyRoomsWeb.Meta.description(assigns)} />
    <meta
      :if={assigns[:conn]}
      property="og:url"
      content={Phoenix.Controller.current_url(@conn, %{})}
    />
    <meta property="og:image" content={url(~p"/images/og.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pubky Rooms — Live rooms. Your homeserver." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={PubkyRoomsWeb.Meta.title(assigns)} />
    <meta name="twitter:description" content={PubkyRoomsWeb.Meta.description(assigns)} />
    <meta name="twitter:image" content={url(~p"/images/og.png")} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="min-h-dvh">
    {@inner_content}
  </body>
</html>
